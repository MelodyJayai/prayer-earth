{
  "expo": {
    "name": "祷告地球",
    "slug": "prayer-earth",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "scheme": "prayerearth",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.prayerearth.app",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "org.prayerearth.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-v2.png",
        "monochromeImage": "./assets/adaptive-icon-v2.png",
        "backgroundColor": "#173F37"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F0",
          "image": "./assets/splash-icon-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
