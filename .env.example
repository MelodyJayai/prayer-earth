# Public Expo variables (EXPO_PUBLIC_*) are embedded in the client bundle.
# Keep values here non-sensitive; never put service credentials in this file.

# Runtime environment used by the app and telemetry.
EXPO_PUBLIC_APP_ENV=development

# API gateway used by the service adapter (leave empty while running offline-only).
EXPO_PUBLIC_API_BASE_URL=

# Network request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Optional client-side feature switches. Use "false" until the corresponding
# backend capability is available in the target environment.
EXPO_PUBLIC_ENABLE_REMOTE_CONTENT=false
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# Server-only secrets (database keys, JWT signing keys, admin tokens, etc.)
# must be configured in the backend/CI secret store and must never use the
# EXPO_PUBLIC_ prefix.
