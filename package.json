{
  "name": "prayer-earth",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "import:content": "python scripts/import-wechat-content.py",
    "serve:static": "python scripts/serve-static.py --directory dist",
    "verify": "npm run typecheck && npm run lint && npm run test && npx expo-doctor",
    "build:web": "expo export --platform web && python scripts/generate-reader.py --dist dist"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-blur": "~57.0.3",
    "expo-constants": "^57.0.13",
    "expo-dev-client": "~57.0.20",
    "expo-font": "^57.0.1",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "^57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
